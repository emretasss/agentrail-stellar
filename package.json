{
  "name": "agentrail-stellar",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && cargo test",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview --host 0.0.0.0",
    "test:contracts": "cargo test",
    "build:contract": "stellar contract build --package agent-pay --optimize",
    "deploy:testnet": "bash scripts/deploy-testnet.sh"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "^10.68.0",
    "@stellar/freighter-api": "^4.1.0",
    "@stellar/stellar-sdk": "^14.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright-core": "^1.60.0",
    "typescript": "^5.7.2",
    "vite": "^8.1.5"
  }
}
